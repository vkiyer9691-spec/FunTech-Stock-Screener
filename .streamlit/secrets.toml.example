# Copy this file to secrets.toml and fill in your project values.
# secrets.toml is gitignored and must not be committed.

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_ANON_KEY"

# Optional — weekday 8:30 AM IST digest. Without these, previews are saved to digest_outbox/.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "you@gmail.com"
SMTP_PASSWORD = "app-password"
SMTP_FROM = "FunTech Screener <you@gmail.com>"
