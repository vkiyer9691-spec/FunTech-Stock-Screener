# Streamlit Cloud: Settings → Secrets (same names as GitHub, anon key only).
# Local: copy this file to secrets.toml and fill in values. Do not commit secrets.toml.

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_ANON_KEY"

# Optional — weekday 8:30 AM IST digest. Without these, previews are saved to digest_outbox/.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "you@gmail.com"
SMTP_PASSWORD = "app-password"
SMTP_FROM = "FunTech Screener <you@gmail.com>"
# Optional. Default Reply-To is noreply@funtech.invalid so Reply does not use Gmail.
# SMTP_REPLY_TO = "off"
